{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/packages",
      "missing": [{ "type": "query", "key": "tier" }],
      "destination": "/brochure",
      "permanent": true
    },
    {
      "source": "/brochure/:slug(gurugram|gurgaon|delhi|delhi-ncr)",
      "destination": "/brochure/ncr",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/staff",
      "destination": "/staff.html"
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://picnic-dashboard-nu.vercel.app https://dashboard.picnicstories.com"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://picnic-dashboard-nu.vercel.app https://dashboard.picnicstories.com"
        }
      ]
    }
  ]
}
