# Supabase — ANON/publishable key only. All three pricing RPCs grant EXECUTE to
# anon, so the bot never needs the service key. Do not put a service key here.
SUPABASE_URL=https://evmftrogyzoudiccqkya.supabase.co
SUPABASE_ANON_KEY=

# Which brain. anthropic | gemini
BOT_PROVIDER=gemini

# Leave BOT_MODEL blank to use the provider default
#   anthropic -> claude-haiku-4-5
#   gemini    -> gemini-3.5-flash
BOT_MODEL=

ANTHROPIC_API_KEY=

# TWO GOOGLE CLOUD PROJECTS, TWO KEYS. This is deliberate.
#
# Enabling billing on a project DELETES its free tier outright — every call
# becomes billable from the first token, and there is no hybrid. So keep the
# free project for development and make a separate billed project for live.
#
#   dev  = free project. Fine for `npm run replay` (synthetic cases, no real
#          customer data). Capped ~10 RPM; the adapter retries 429s.
#   prod = billed project. Tier 1 gives 150-300 RPM. Required before a real
#          customer message reaches the bot, because free-tier inputs and
#          outputs may be used to improve Google's models and this bot handles
#          names, phone numbers and event details.
GEMINI_API_KEY=

# v1 scope: Beige Cafe only (venue 14). Widen only after backfilling
# venue_packages for the venue you are adding.
BOT_VENUE_IDS=14
